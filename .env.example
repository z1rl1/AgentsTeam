# MiniMax API — основной LLM и генерация картинок
MINIMAX_API_KEY=your_minimax_api_key_here

# Модель для генерации кода игры
GAMEFORGE_MODEL=MiniMax-M2.7

# Генерация ассетов через MiniMax image API
GAMEFORGE_GENERATE_ASSETS=1
GAMEFORGE_REQUIRE_GENERATED_ASSETS=1

# Максимум токенов на генерацию (200k = без жёсткого лимита)
GAMEFORGE_MAX_TOKENS=200000

# Количество попыток генерации до сдачи
GAMEFORGE_MAX_ATTEMPTS=4

# OpenRouter — резерв если MiniMax недоступен (опционально)
# OPENROUTER_API_KEY=your_openrouter_key_here
